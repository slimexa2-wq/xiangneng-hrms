generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SYSTEM_ADMIN
  GROUP_LEADER
  HEADQUARTERS_MANAGER
  BRANCH_MANAGER
  DEPARTMENT_MANAGER
  INTERNAL_HR
  RECRUITER
  PROJECT_OPERATOR
  RESOURCE_SPECIALIST
  FINANCE_REVIEWER
  CASHIER
  DEPARTMENT_REIMBURSEMENT_CLERK
  SUPPLIER_ADMIN
  SUPPLIER
  OUTSOURCED_EMPLOYEE
  EMPLOYEE
  JOB_SEEKER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  HISTORICAL
  PENDING_CONFIRMATION
}

enum ResponsibilityType {
  CLIENT
  OURS
  JOINT
  PENDING_CONFIRMATION
}

enum InterviewStatus {
  PENDING_ARRIVAL
  ARRIVED
  PASSED
  FAILED
  ABANDONED
}

enum EmploymentStatus {
  APPLICANT
  INTERVIEWING
  PENDING_ONBOARD
  ACTIVE
  LEFT
}

enum PolicyType {
  SUPPLIER
  EMPLOYEE_REFERRAL
}

enum JobStatus {
  RECRUITING
  PAUSED
  FILLED
  ENDED
}

enum ApplicationSource {
  OPERATOR
  SUPPLIER
  SELF
  REFERRAL
}

enum RewardStatus {
  PENDING
  ACHIEVED
  PAID
  CANCELLED
}

enum SalarySlipStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum ImportStatus {
  PREVIEW
  COMMITTED
  PARTIAL
  FAILED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_NOT_CONFIGURED
}

enum AiActionStatus {
  PREVIEWED
  EXECUTED
  CANCELLED
  EXPIRED
  FAILED
}

enum OrganizationUnitType {
  GROUP
  LEGAL_ENTITY
  BRANCH
  CENTER
  DEPARTMENT
}

enum InternalEmployeeStatus {
  ACTIVE
  DISABLED
  LEFT
  ARCHIVED
}

enum InternalEmployeeChangeType {
  ONBOARD
  TRANSFER
  DISABLE
  ENABLE
  OFFBOARD
  ARCHIVE
}

enum RoleAssignmentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum DataScopeType {
  SELF
  ORG_UNIT
  CENTER
  BRANCH
  PROJECT
  SUPPLIER
  GROUP
}

enum ReimbursementStatus {
  PENDING_SUBMISSION
  DEPARTMENT_PREPARING
  OWNER_REVIEWING
  FINANCE_REVIEWING
  APPROVED
  PENDING_PAYMENT
  PAID
}

enum ReimbursementAttachmentType {
  PAYMENT_VOUCHER
  INVOICE
  SUPPORTING
}

enum ReimbursementIssueStatus {
  OPEN
  RESOLVED
}

enum ReimbursementApprovalDecision {
  APPROVED
  REJECTED
  RETURNED
}

enum ReimbursementArtifactType {
  REIMBURSEMENT_FORM
  PAYMENT_PACKAGE
  INVOICE_PACKAGE
}

enum ReimbursementArtifactStatus {
  PENDING
  GENERATED
  FAILED
}

model Branch {
  id         String    @id @default(uuid()) @db.Uuid
  sourceCode String?   @unique @map("source_code") @db.VarChar(64)
  name       String    @unique @db.VarChar(200)
  remark     String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  projects   Project[]
  users      User[]
  organizationUnits OrganizationUnit[]
  internalEmployees InternalEmployee[]
  internalEmployments InternalEmployment[]
  dataScopeBindings DataScopeBinding[]
  reimbursementBatches ReimbursementBatch[]

  @@map("branches")
}

model LegalEntity {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @unique @db.VarChar(200)
  taxNumber   String?  @unique @map("tax_number") @db.VarChar(64)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  organizationUnits OrganizationUnit[]
  internalEmployees InternalEmployee[]
  employments InternalEmployment[]

  @@index([isActive, name])
  @@map("legal_entities")
}

model OrganizationUnit {
  id            String               @id @default(uuid()) @db.Uuid
  code          String               @unique @db.VarChar(64)
  name          String               @db.VarChar(200)
  type          OrganizationUnitType
  parentId      String?              @map("parent_id") @db.Uuid
  legalEntityId String?              @map("legal_entity_id") @db.Uuid
  branchId      String?              @map("branch_id") @db.Uuid
  path          String               @db.VarChar(1000)
  sortOrder     Int                  @default(0) @map("sort_order")
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  parent        OrganizationUnit?    @relation("OrganizationUnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      OrganizationUnit[]   @relation("OrganizationUnitTree")
  legalEntity   LegalEntity?         @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  branch        Branch?              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  positions     Position[]
  internalEmployees InternalEmployee[]
  employments   InternalEmployment[]
  dataScopeBindings DataScopeBinding[]
  reimbursementBatches ReimbursementBatch[]

  @@unique([parentId, name])
  @@index([parentId, sortOrder])
  @@index([legalEntityId, type, isActive])
  @@index([branchId, type, isActive])
  @@index([path])
  @@map("organization_units")
}

model Position {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique @db.VarChar(64)
  name               String   @db.VarChar(120)
  organizationUnitId String?  @map("organization_unit_id") @db.Uuid
  description        String?  @db.Text
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  organizationUnit   OrganizationUnit? @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)
  internalEmployees  InternalEmployee[]
  employments        InternalEmployment[]

  @@index([organizationUnitId, isActive])
  @@index([name])
  @@map("positions")
}

model JobGrade {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @unique @db.VarChar(120)
  level       Int
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  internalEmployees InternalEmployee[]
  employments InternalEmployment[]

  @@index([level, isActive])
  @@map("job_grades")
}

model InternalEmployee {
  id                 String                 @id @default(uuid()) @db.Uuid
  employeeNo         String                 @unique @map("employee_no") @db.VarChar(64)
  userId             String?                @unique @map("user_id") @db.Uuid
  name               String                 @db.VarChar(64)
  phone              String                 @unique @db.VarChar(32)
  idCard             String                 @unique @map("id_card") @db.VarChar(32)
  email              String?                @db.VarChar(200)
  legalEntityId      String?                @map("legal_entity_id") @db.Uuid
  branchId           String?                @map("branch_id") @db.Uuid
  organizationUnitId String?                @map("organization_unit_id") @db.Uuid
  positionId         String?                @map("position_id") @db.Uuid
  jobGradeId         String?                @map("job_grade_id") @db.Uuid
  status             InternalEmployeeStatus @default(ACTIVE)
  onboardDate        DateTime               @map("onboard_date") @db.Date
  offboardDate       DateTime?              @map("offboard_date") @db.Date
  offboardReason     String?                @map("offboard_reason") @db.VarChar(500)
  version            Int                    @default(1)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  user               User?                  @relation("InternalEmployeeUser", fields: [userId], references: [id], onDelete: Restrict)
  legalEntity        LegalEntity?           @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  branch             Branch?                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  organizationUnit   OrganizationUnit?      @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)
  position           Position?              @relation(fields: [positionId], references: [id], onDelete: Restrict)
  jobGrade           JobGrade?              @relation(fields: [jobGradeId], references: [id], onDelete: Restrict)
  employments        InternalEmployment[]
  changes            InternalEmployeeChange[]

  @@unique([id, version])
  @@index([status, branchId, organizationUnitId])
  @@index([legalEntityId, status])
  @@index([positionId, status])
  @@index([name])
  @@map("internal_employees")
}

model InternalEmployment {
  id                 String   @id @default(uuid()) @db.Uuid
  employeeId         String   @map("employee_id") @db.Uuid
  legalEntityId      String?  @map("legal_entity_id") @db.Uuid
  branchId           String?  @map("branch_id") @db.Uuid
  organizationUnitId String   @map("organization_unit_id") @db.Uuid
  positionId         String   @map("position_id") @db.Uuid
  jobGradeId         String?  @map("job_grade_id") @db.Uuid
  startedAt          DateTime @map("started_at") @db.Date
  endedAt            DateTime? @map("ended_at") @db.Date
  isPrimary          Boolean  @default(true) @map("is_primary")
  reason             String?  @db.VarChar(500)
  createdAt          DateTime @default(now()) @map("created_at")
  employee           InternalEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  legalEntity        LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  branch             Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)
  organizationUnit   OrganizationUnit @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)
  position           Position @relation(fields: [positionId], references: [id], onDelete: Restrict)
  jobGrade           JobGrade? @relation(fields: [jobGradeId], references: [id], onDelete: Restrict)

  @@index([employeeId, endedAt])
  @@index([organizationUnitId, endedAt])
  @@index([branchId, endedAt])
  @@index([positionId, endedAt])
  @@map("internal_employments")
}

model InternalEmployeeChange {
  id          String                     @id @default(uuid()) @db.Uuid
  employeeId  String                     @map("employee_id") @db.Uuid
  actorId     String?                    @map("actor_id") @db.Uuid
  type        InternalEmployeeChangeType
  effectiveAt DateTime                   @map("effective_at") @db.Date
  reason      String?                    @db.VarChar(500)
  before      Json?
  after       Json?
  createdAt   DateTime                   @default(now()) @map("created_at")
  employee    InternalEmployee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveAt])
  @@index([actorId, createdAt])
  @@map("internal_employee_changes")
}

model Project {
  id               String              @id @default(uuid()) @db.Uuid
  sourceProjectId  String?             @unique @map("source_project_id") @db.VarChar(64)
  branchId         String              @map("branch_id") @db.Uuid
  name             String              @db.VarChar(200)
  isExternal       Boolean             @default(false) @map("is_external")
  businessType     String?             @map("business_type") @db.VarChar(64)
  status           ProjectStatus?
  managerName      String?             @map("manager_name") @db.VarChar(64)
  managerPhone     String?             @map("manager_phone") @db.VarChar(32)
  cooperationStart DateTime?           @map("cooperation_start") @db.Date
  cooperationEnd   DateTime?           @map("cooperation_end") @db.Date
  responsibility   ResponsibilityType?
  description      String?             @db.Text
  remark           String?             @db.Text
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  images           ProjectImage[]
  people           Person[]
  jobDemands       JobDemand[]
  policies         Policy[]
  supplierLinks    SupplierProject[]
  userLinks        UserProject[]
  portalQrCodes    PortalQrCode[]
  dataScopeBindings DataScopeBinding[]
  reimbursementBatches ReimbursementBatch[]

  @@unique([branchId, name])
  @@index([branchId, status])
  @@map("projects")
}

model ProjectImage {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  storageKey   String   @unique @map("storage_key") @db.VarChar(128)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(128)
  sizeBytes    Int      @map("size_bytes")
  sortOrder    Int      @default(0) @map("sort_order")
  note         String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_images")
}

model Supplier {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @unique @db.VarChar(200)
  contactName       String?            @map("contact_name") @db.VarChar(64)
  contactPhone      String?            @map("contact_phone") @db.VarChar(32)
  level             String?            @db.VarChar(32)
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  projectLinks      SupplierProject[]
  people            Person[]
  policies          Policy[]
  applications      Application[]
  users             User[]
  dataScopeBindings DataScopeBinding[]
  portalSettlements PortalSettlement[]
  reimbursementBatches ReimbursementBatch[]

  @@map("suppliers")
}

model SupplierProject {
  supplierId String   @map("supplier_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([supplierId, projectId])
  @@index([projectId])
  @@map("supplier_project_relations")
}

model Policy {
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String           @db.VarChar(200)
  type                  PolicyType
  projectId             String           @map("project_id") @db.Uuid
  jobTitle              String?          @map("job_title") @db.VarChar(120)
  supplierId            String?          @map("supplier_id") @db.Uuid
  supplierLevel         String?          @map("supplier_level") @db.VarChar(32)
  employeeType          String?          @map("employee_type") @db.VarChar(64)
  amount                Decimal          @db.Decimal(12, 2)
  achievementConditions String           @map("achievement_conditions") @db.Text
  exclusionConditions   String?          @map("exclusion_conditions") @db.Text
  effectiveAt           DateTime         @map("effective_at") @db.Date
  expiresAt             DateTime?        @map("expires_at") @db.Date
  notes                 String?          @db.Text
  version               Int              @default(1)
  isActive              Boolean          @default(true) @map("is_active")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  project               Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  supplier              Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierJobDemands    JobDemand[]      @relation("SupplierPolicyJobDemands")
  referralJobDemands    JobDemand[]      @relation("ReferralPolicyJobDemands")
  matchedPeople         Person[]         @relation("MatchedSupplierPolicy")
  referralRecords       ReferralRecord[]
  rewardRecords         ReferralReward[]

  @@index([projectId, type, isActive])
  @@index([supplierId, type])
  @@map("policies")
}

model JobDemand {
  id               String           @id @default(uuid()) @db.Uuid
  projectId        String           @map("project_id") @db.Uuid
  title            String           @db.VarChar(120)
  requiredCount    Int              @map("required_count")
  requirements     String           @db.Text
  salary           String           @db.VarChar(500)
  workTime         String           @map("work_time") @db.VarChar(500)
  workLocation     String           @map("work_location") @db.VarChar(500)
  deadline         DateTime
  status           JobStatus        @default(RECRUITING)
  supplierPolicyId String?          @map("supplier_policy_id") @db.Uuid
  referralPolicyId String?          @map("referral_policy_id") @db.Uuid
  notes            String?          @db.Text
  createdById      String?          @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  supplierPolicy   Policy?          @relation("SupplierPolicyJobDemands", fields: [supplierPolicyId], references: [id], onDelete: Restrict)
  referralPolicy   Policy?          @relation("ReferralPolicyJobDemands", fields: [referralPolicyId], references: [id], onDelete: Restrict)
  createdBy        User?            @relation("CreatedJobDemands", fields: [createdById], references: [id], onDelete: SetNull)
  applications     Application[]
  referrals        ReferralRecord[]
  referralShares   ReferralShare[]
  portalFavorites  PortalFavorite[]
  portalQrCodes    PortalQrCode[]

  @@index([projectId, status, deadline])
  @@map("job_demands")
}

model Person {
  id                       String                 @id @default(uuid()) @db.Uuid
  name                     String                 @db.VarChar(64)
  idCard                   String                 @unique @map("id_card") @db.VarChar(18)
  phone                    String                 @db.VarChar(32)
  gender                   String?                @db.VarChar(16)
  age                      Int?
  ethnicity                String?                @db.VarChar(32)
  origin                   String?                @db.VarChar(120)
  projectId                String                 @map("project_id") @db.Uuid
  jobTitle                 String                 @map("job_title") @db.VarChar(120)
  status                   EmploymentStatus       @default(APPLICANT)
  interviewStatus          InterviewStatus        @default(PENDING_ARRIVAL) @map("interview_status")
  interviewDate            DateTime?              @map("interview_date") @db.Date
  supplierId               String?                @map("supplier_id") @db.Uuid
  recommenderUserId        String?                @map("recommender_user_id") @db.Uuid
  recommenderName          String?                @map("recommender_name") @db.VarChar(64)
  emergencyContactName     String?                @map("emergency_contact_name") @db.VarChar(64)
  emergencyContactPhone    String?                @map("emergency_contact_phone") @db.VarChar(32)
  emergencyContactRelation String?                @map("emergency_contact_relation") @db.VarChar(32)
  onboardDate              DateTime?              @map("onboard_date") @db.Date
  offboardDate             DateTime?              @map("offboard_date") @db.Date
  offboardReason           String?                @map("offboard_reason") @db.VarChar(500)
  employeeNo               String?                @unique @map("employee_no") @db.VarChar(64)
  insuranceTypes           Json                   @default("[]") @map("insurance_types")
  supplierPolicyId         String?                @map("supplier_policy_id") @db.Uuid
  supplierPolicySnapshot   Json?                  @map("supplier_policy_snapshot")
  notes                    String?                @db.Text
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  project                  Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  supplier                 Supplier?              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  recommender              User?                  @relation("RecommendedPeople", fields: [recommenderUserId], references: [id], onDelete: SetNull)
  supplierPolicy           Policy?                @relation("MatchedSupplierPolicy", fields: [supplierPolicyId], references: [id], onDelete: Restrict)
  files                    PersonFile[]
  statusLogs               PersonStatusLog[]
  applications             Application[]
  referrals                ReferralRecord[]
  salarySlips              SalarySlip[]
  user                     User?                  @relation("PersonUser")
  aiDemoSnapshot           AiDemoSnapshot?
  portalAdvances           PortalAdvance[]
  portalSettlementItems    PortalSettlementItem[]

  @@index([projectId, status])
  @@index([supplierId, status])
  @@index([recommenderUserId])
  @@index([phone])
  @@map("people")
}

model PersonFile {
  id           String   @id @default(uuid()) @db.Uuid
  personId     String   @map("person_id") @db.Uuid
  storageKey   String   @unique @map("storage_key") @db.VarChar(128)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(128)
  sizeBytes    Int      @map("size_bytes")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation("UploadedPersonFiles", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([personId])
  @@map("person_files")
}

model PersonStatusLog {
  id              String            @id @default(uuid()) @db.Uuid
  personId        String            @map("person_id") @db.Uuid
  fromStatus      EmploymentStatus? @map("from_status")
  toStatus        EmploymentStatus  @map("to_status")
  interviewStatus InterviewStatus?  @map("interview_status")
  action          String            @db.VarChar(64)
  notes           String?           @db.Text
  actorId         String?           @map("actor_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  person          Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  actor           User?             @relation("PersonStatusActors", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([personId, createdAt])
  @@map("person_status_logs")
}

model Application {
  id                String            @id @default(uuid()) @db.Uuid
  personId          String            @map("person_id") @db.Uuid
  jobDemandId       String            @map("job_demand_id") @db.Uuid
  source            ApplicationSource
  supplierId        String?           @map("supplier_id") @db.Uuid
  recommenderUserId String?           @map("recommender_user_id") @db.Uuid
  recommenderName   String?           @map("recommender_name") @db.VarChar(64)
  interviewStatus   InterviewStatus   @default(PENDING_ARRIVAL) @map("interview_status")
  interviewDate     DateTime?         @map("interview_date") @db.Date
  employmentStatus  EmploymentStatus  @default(APPLICANT) @map("employment_status")
  onboardDate       DateTime?         @map("onboard_date") @db.Date
  offboardDate      DateTime?         @map("offboard_date") @db.Date
  offboardReason    String?           @map("offboard_reason") @db.VarChar(500)
  appliedAt         DateTime          @default(now()) @map("applied_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  person            Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  jobDemand         JobDemand         @relation(fields: [jobDemandId], references: [id], onDelete: Restrict)
  supplier          Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  recommender       User?             @relation("ApplicationRecommenders", fields: [recommenderUserId], references: [id], onDelete: SetNull)
  referral          ReferralRecord?

  @@index([personId, jobDemandId, appliedAt])
  @@index([jobDemandId, source])
  @@index([supplierId])
  @@map("applications")
}

model ReferralRecord {
  id                String          @id @default(uuid()) @db.Uuid
  applicationId     String          @unique @map("application_id") @db.Uuid
  personId          String          @map("person_id") @db.Uuid
  jobDemandId       String          @map("job_demand_id") @db.Uuid
  recommenderUserId String          @map("recommender_user_id") @db.Uuid
  policyId          String?         @map("policy_id") @db.Uuid
  policySnapshot    Json?           @map("policy_snapshot")
  createdAt         DateTime        @default(now()) @map("created_at")
  application       Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  person            Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  jobDemand         JobDemand       @relation(fields: [jobDemandId], references: [id], onDelete: Restrict)
  recommender       User            @relation("ReferralRecommenders", fields: [recommenderUserId], references: [id], onDelete: Restrict)
  policy            Policy?         @relation(fields: [policyId], references: [id], onDelete: Restrict)
  reward            ReferralReward?

