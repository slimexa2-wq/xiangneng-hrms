  updatedAt          DateTime            @updatedAt @map("updated_at")
  applicant          User                @relation("ReimbursementApplicants", fields: [applicantUserId], references: [id], onDelete: Restrict)
  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  organizationUnit   OrganizationUnit?   @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines              ReimbursementLine[]
  attachments        ReimbursementAttachment[]
  issues             ReimbursementIssue[]
  approvals          ReimbursementApproval[]
  payment            ReimbursementPayment?
  artifacts          ReimbursementArtifact[]

  @@unique([id, version])
  @@index([applicantUserId, status, createdAt])
  @@index([branchId, status, createdAt])
  @@index([organizationUnitId, status, createdAt])
  @@index([projectId, status, createdAt])
  @@index([supplierId, status, createdAt])
  @@map("reimbursement_batches")
}

model ReimbursementLine {
  id             String   @id @default(uuid()) @db.Uuid
  batchId        String   @map("batch_id") @db.Uuid
  sequence       Int
  expenseDate    DateTime @map("expense_date") @db.Date
  category       String   @db.VarChar(80)
  description    String   @db.VarChar(500)
  payeeName      String?  @map("payee_name") @db.VarChar(120)
  payeeAccount   String?  @map("payee_account") @db.VarChar(120)
  payeeBank      String?  @map("payee_bank") @db.VarChar(200)
  paymentCents   Int      @map("payment_cents")
  invoiceCents   Int      @map("invoice_cents")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  batch          ReimbursementBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  attachments    ReimbursementAttachment[]
  issues         ReimbursementIssue[]

  @@unique([batchId, sequence])
  @@index([batchId, expenseDate])
  @@map("reimbursement_lines")
}

model ReimbursementAttachment {
  id           String                      @id @default(uuid()) @db.Uuid
  batchId      String                      @map("batch_id") @db.Uuid
  lineId       String?                     @map("line_id") @db.Uuid
  type         ReimbursementAttachmentType
  storageKey   String                      @unique @map("storage_key") @db.VarChar(500)
  originalName String                      @map("original_name") @db.VarChar(255)
  mimeType     String                      @map("mime_type") @db.VarChar(128)
  sizeBytes    Int                         @map("size_bytes")
  sha256       String                      @db.VarChar(64)
  uploadedById String?                     @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime                    @default(now()) @map("created_at")
  batch        ReimbursementBatch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  line         ReimbursementLine?          @relation(fields: [lineId], references: [id], onDelete: SetNull)
  uploadedBy   User?                       @relation("ReimbursementUploaders", fields: [uploadedById], references: [id], onDelete: SetNull)
  paymentProof ReimbursementPayment?       @relation("ReimbursementPaymentProof")

  @@index([batchId, type, createdAt])
  @@index([lineId, type, createdAt])
  @@index([uploadedById, createdAt])
  @@map("reimbursement_attachments")
}

model ReimbursementIssue {
  id           String                   @id @default(uuid()) @db.Uuid
  batchId      String                   @map("batch_id") @db.Uuid
  lineId       String?                  @map("line_id") @db.Uuid
  raisedById   String                   @map("raised_by_id") @db.Uuid
  resolvedById String?                  @map("resolved_by_id") @db.Uuid
  type         String                   @db.VarChar(80)
  description  String                   @db.VarChar(500)
  status       ReimbursementIssueStatus @default(OPEN)
  resolution   String?                  @db.VarChar(500)
  resolvedAt   DateTime?                @map("resolved_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  batch        ReimbursementBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  line         ReimbursementLine?       @relation(fields: [lineId], references: [id], onDelete: SetNull)
  raisedBy     User                     @relation("ReimbursementIssueRaisers", fields: [raisedById], references: [id], onDelete: Restrict)
  resolvedBy   User?                    @relation("ReimbursementIssueResolvers", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([batchId, status, createdAt])
  @@index([lineId, status])
  @@index([raisedById, createdAt])
  @@map("reimbursement_issues")
}

model ReimbursementApproval {
  id         String                        @id @default(uuid()) @db.Uuid
  batchId    String                        @map("batch_id") @db.Uuid
  actorId    String                        @map("actor_id") @db.Uuid
  fromStatus ReimbursementStatus           @map("from_status")
  toStatus   ReimbursementStatus           @map("to_status")
  decision   ReimbursementApprovalDecision
  comment    String?                       @db.VarChar(500)
  createdAt  DateTime                      @default(now()) @map("created_at")
  batch      ReimbursementBatch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  actor      User                          @relation("ReimbursementApprovalActors", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([batchId, createdAt])
  @@index([actorId, createdAt])
  @@map("reimbursement_approvals")
}

model ReimbursementPayment {
  id                String   @id @default(uuid()) @db.Uuid
  batchId           String   @unique @map("batch_id") @db.Uuid
  amountCents       Int      @map("amount_cents")
  reference         String   @unique @db.VarChar(120)
  paidById          String   @map("paid_by_id") @db.Uuid
  paidAt            DateTime @map("paid_at")
  proofAttachmentId String?  @unique @map("proof_attachment_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  batch             ReimbursementBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  paidBy            User               @relation("ReimbursementPayers", fields: [paidById], references: [id], onDelete: Restrict)
  proofAttachment   ReimbursementAttachment? @relation("ReimbursementPaymentProof", fields: [proofAttachmentId], references: [id], onDelete: Restrict)

  @@index([paidById, paidAt])
  @@index([paidAt])
  @@map("reimbursement_payments")
}

model ReimbursementArtifact {
  id            String                      @id @default(uuid()) @db.Uuid
  batchId       String                      @map("batch_id") @db.Uuid
  type          ReimbursementArtifactType
  status        ReimbursementArtifactStatus @default(PENDING)
  storageKey    String?                     @unique @map("storage_key") @db.VarChar(500)
  originalName  String?                     @map("original_name") @db.VarChar(255)
  error         String?                     @db.Text
  generatedById String?                     @map("generated_by_id") @db.Uuid
  generatedAt   DateTime?                   @map("generated_at")
  createdAt     DateTime                    @default(now()) @map("created_at")
  updatedAt     DateTime                    @updatedAt @map("updated_at")
  batch         ReimbursementBatch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  generatedBy   User?                       @relation("ReimbursementArtifactGenerators", fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([batchId, type])
  @@index([batchId, status])
  @@index([generatedById, createdAt])
  @@map("reimbursement_artifacts")
}
