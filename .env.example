NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3310
ADMIN_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4320,http://127.0.0.1:4320
VITE_API_BASE_URL=http://localhost:3310/api
DATABASE_URL=postgresql://xiangneng:change-me@localhost:5432/xiangneng_hrms?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe-DevOnly-2026!
SEED_ADMIN_DISPLAY_NAME=系统管理员
UPLOAD_DIR=./apps/api/uploads
MAX_UPLOAD_MB=20
# 默认本地存储；生产切换腾讯云 COS 时使用 cos，并通过服务端密钥注入。
FILE_STORAGE_DRIVER=local
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_ENDPOINT=
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
WECHAT_OFFICIAL_APP_ID=
WECHAT_OFFICIAL_APP_SECRET=
WECHAT_TEMPLATE_APPLICATION_SUCCESS=
WECHAT_TEMPLATE_INTERVIEW_REMINDER=
WECHAT_TEMPLATE_EMPLOYMENT_STATUS=
WECHAT_TEMPLATE_SALARY_PUBLISHED=
WECHAT_TEMPLATE_JOB_DEMAND=
WECHAT_MINIAPP_PATH=/pages/index/index
TARO_APP_API_BASE_URL=http://127.0.0.1:3310/api
TARO_APP_WECHAT_CONFIGURED=false
TARO_APP_NOTIFICATION_CONFIGURED=false

# 本地 AI 助手（仅后端读取，禁止写入前端环境变量）
XIANGNENG_LLM_BASE_URL=http://127.0.0.1:11434/v1
XIANGNENG_LLM_MODEL=qwen3.5:4b
# Optional: larger local model (e.g. qwen3:14b) for better chat; set XIANGNENG_LLM_MODEL after `ollama pull qwen3:14b`. General chat auto-falls back to this model if the primary is unavailable.
XIANGNENG_LLM_FALLBACK_MODEL=qwen3.5:4b
# 统一使用已授权拉取的本地 Qwen3.5 4B，避免依赖未安装的第二个模型。
XIANGNENG_LLM_CHAT_MODEL=qwen3.5:4b
XIANGNENG_LLM_API_KEY=ollama-local
AI_MODEL_TIMEOUT_MS=10000
AI_ACTION_TTL_SECONDS=600
AI_DEMO_MODE=false
# AI_SKILL_ROOT=C:/absolute/path/to/skills/xiangneng-ai-business-assistant
